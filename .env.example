# ==============================================================================
# ANIVEL MEDIA — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development, or add these variables in
# your Vercel Project Settings (Settings -> Environment Variables).

# --- Primary Integrations ---
# Google Apps Script Webhook URL for automated Google Sheets lead ingestion:
GOOGLE_SHEET_WEBHOOK_URL=

# Official WhatsApp Contact Number (Format: CountryCode + Number, e.g. 919876543210):
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Business Alert & Notification Recipient Email:
ANIVEL_BUSINESS_EMAIL=

# Sender Email Address for Outgoing Notifications:
NOTIFICATION_FROM_EMAIL=

# --- Optional Integrations ---
# Optional: Resend API Key for direct transactional emails (if configured)
RESEND_API_KEY=

# Optional: Google Cloud Service Account (if using direct Google Sheets v4 API)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: External Automation Webhook (n8n, Make, Zapier)
N8N_WEBHOOK_URL=
